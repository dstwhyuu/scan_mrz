# ============================================================
# Hotel FO OCR Service — Environment Variables
# Copy file ini ke .env dan sesuaikan nilainya.
# ============================================================

# API Key untuk validasi request dari Spring Boot (harus sama dengan OCR_INTERNAL_API_KEY di backend)
INTERNAL_API_KEY=your-secret-api-key-here

# Path ke binary Tesseract (sesuaikan jika bukan default)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Docker: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
